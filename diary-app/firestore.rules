rules_version = '2';
// Private documents: users/{googleUid}/entries|student_records|roster/{id}.
// Records contain only the domain fields below, version (integer), and
// created_at/updated_at (server timestamps). Ownership is immutable in the path.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function stringSize(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validBase(d) {
      return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && stringSize(d.title,1,120) && stringSize(d.content,1,100000)
        && d.version is int && d.version >= 1
        && d.created_at is timestamp && d.updated_at is timestamp;
    }
    function validEntry(d) {
      return d.keys().hasAll(['date','title','content','mood','starred','version','created_at','updated_at'])
        && d.keys().hasOnly(['date','title','content','mood','starred','version','created_at','updated_at'])
        && validBase(d) && d.mood in ['great','good','okay','low','sad'] && d.starred is bool;
    }
    function validStudent(d, uid) {
      return d.keys().hasAll(['date','title','content','student_name','classroom','student_number','category','follow_up','roster_id','version','created_at','updated_at'])
        && d.keys().hasOnly(['date','title','content','student_name','classroom','student_number','category','follow_up','roster_id','version','created_at','updated_at'])
        && validBase(d) && stringSize(d.student_name,1,80) && stringSize(d.classroom,0,80)
        && stringSize(d.student_number,0,20) && stringSize(d.follow_up,0,10000)
        && d.category in ['observation','counseling','learning','school-life']
        && (d.roster_id == null || (stringSize(d.roster_id,1,128)
          && exists(/databases/$(database)/documents/users/$(uid)/roster/$(d.roster_id))
          && get(/databases/$(database)/documents/users/$(uid)/roster/$(d.roster_id)).data.student_name == d.student_name
          && get(/databases/$(database)/documents/users/$(uid)/roster/$(d.roster_id)).data.classroom == d.classroom
          && get(/databases/$(database)/documents/users/$(uid)/roster/$(d.roster_id)).data.student_number == d.student_number));
    }
    function validRoster(d) {
      return d.keys().hasAll(['grade','class_no','student_number','student_name','classroom','version','created_at','updated_at'])
        && d.keys().hasOnly(['grade','class_no','student_number','student_name','classroom','version','created_at','updated_at'])
        && d.grade is int && d.grade >= 1 && d.grade <= 12
        && d.class_no is int && d.class_no >= 1 && d.class_no <= 100
        && stringSize(d.student_number,1,20) && stringSize(d.student_name,1,80) && stringSize(d.classroom,1,80)
        && d.version is int && d.version >= 1 && d.created_at is timestamp && d.updated_at is timestamp;
    }
    function newVersion(d) { return d.version == 1 && d.created_at == request.time && d.updated_at == request.time; }
    function nextVersion(d) { return d.created_at == resource.data.created_at && d.updated_at == request.time && d.version == resource.data.version + 1; }
    match /users/{uid}/entries/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validEntry(request.resource.data) && newVersion(request.resource.data);
      allow update: if owner(uid) && validEntry(request.resource.data) && nextVersion(request.resource.data);
      allow delete: if owner(uid);
    }
    match /users/{uid}/student_records/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validStudent(request.resource.data,uid) && newVersion(request.resource.data);
      allow update: if owner(uid) && validStudent(request.resource.data,uid) && nextVersion(request.resource.data);
      allow delete: if owner(uid);
    }
    match /users/{uid}/roster/{id} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validRoster(request.resource.data) && newVersion(request.resource.data);
      allow update: if owner(uid) && validRoster(request.resource.data) && nextVersion(request.resource.data);
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read,write: if false; }
  }
}
